---
import Layout from '../layouts/Layout.astro';

const partnerBrands = [
  { name: "Bajaj Allianz General Insurance", file: "/logos/bajaj-allianz.png" },
  { name: "LIC - Life Insurance Corporation", file: "/logos/lic.png" },
  { name: "TATA AIA Life Insurance", file: "/logos/tata-aia.png" },
  { name: "Care Health Insurance", file: "/logos/care-health.png" },
  { name: "Star Health and Allied Insurance", file: "/logos/star-health.png" },
  { name: "Turtlemint Partner Network", file: "/logos/turtlemint.webp" },
  { name: "RenewBuy Partner Network", file: "/logos/renewbuy.png" },
];

const starterPlans = [
  {
    category: "Two-Wheeler Insurance",
    gstBadge: "18% GST",
    badgeColor: "bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700",
    basePrice: "₹538",
    period: "/year*",
    totalPrice: "₹635 with GST",
    tagline: "Mandatory third-party cover for scooters & bikes",
    features: [
      "100% legal RTO compliance",
      "Instant renewal on WhatsApp",
      "Own damage & theft options",
    ],
    waMessage: "Hi Amrut Patel, I need a Two-Wheeler Insurance quote.",
  },
  {
    category: "Car Insurance",
    gstBadge: "18% GST",
    badgeColor: "bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700",
    basePrice: "₹2,094",
    period: "/year*",
    totalPrice: "₹2,471 with GST",
    tagline: "Statutory TP & Comprehensive plans",
    features: [
      "Transfer up to 50% NCB bonus",
      "Cashless body-shops in Surat",
      "Zero-Dep & Engine Protect",
    ],
    waMessage: "Hi Amrut Patel, I need a Car Insurance renewal quote.",
  },
  {
    category: "Family Health (Mediclaim)",
    gstBadge: "0% GST (Save 18%)",
    badgeColor: "bg-emerald-50 text-emerald-800 dark:bg-emerald-950/50 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800",
    basePrice: "₹450",
    period: "/month*",
    totalPrice: "Zero Tax (0% GST)",
    tagline: "₹5 Lakh cover for family in Surat hospitals",
    features: [
      "0% GST: Save 18% tax directly",
      "Cashless admission across Surat",
      "Care, Star & Bajaj Allianz choice",
    ],
    waMessage: "Hi Amrut Patel, I want to compare Health Insurance / Mediclaim plans with 0% GST.",
  },
  {
    category: "Term Life Cover",
    gstBadge: "0% GST (Save 18%)",
    badgeColor: "bg-emerald-50 text-emerald-800 dark:bg-emerald-950/50 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800",
    basePrice: "₹490",
    period: "/month*",
    totalPrice: "Zero Tax (0% GST)",
    tagline: "₹1 Crore pure family life protection",
    features: [
      "100% GST Exempt (Save 18%)",
      "LIC of India & Tata AIA Life",
      "Tax saving under Section 80C",
    ],
    waMessage: "Hi Amrut Patel, please guide me on ₹1 Crore Term Life Insurance plans.",
  },
  {
    category: "Commercial Vehicle",
    gstBadge: "18% GST",
    badgeColor: "bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700",
    basePrice: "Tariff Rate",
    period: "/annual",
    totalPrice: "Based on vehicle type",
    tagline: "Autos, tempos (Tata Ace), and trucks",
    features: [
      "Mandatory RTO legal compliance",
      "Driver & cleaner liability cover",
      "IMT-23 goods protection",
    ],
    waMessage: "Hi Amrut Patel, I need Commercial Vehicle Insurance (Auto/Tempo/Truck).",
  },
  {
    category: "Personal Accident (PA)",
    gstBadge: "18% GST",
    badgeColor: "bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700",
    basePrice: "₹375",
    period: "/year*",
    totalPrice: "₹443 with GST",
    tagline: "₹15 Lakh financial shield for owner-driver",
    features: [
      "Lump sum death & disability cover",
      "24x7 worldwide protection",
      "Zero medical checkups required",
    ],
    waMessage: "Hi Amrut Patel, I want Personal Accident (PA) insurance.",
  },
];

const allCategories = [
  {
    id: "health",
    title: "Health Insurance (Mediclaim)",
    gstNotice: "0% GST Exemption",
    description: "Cashless hospital admission in Surat. Save 18% tax with 0% GST.",
    tags: ["Care", "Star Health", "Bajaj Allianz"],
  },
  {
    id: "car",
    title: "Car Insurance",
    gstNotice: "18% GST",
    description: "Third-party (TP) & full zero-depreciation comprehensive plans.",
    tags: ["50% NCB Transfer", "Cashless Garages"],
  },
  {
    id: "twowheeler",
    title: "Two-Wheeler Insurance",
    gstNotice: "18% GST",
    description: "Fast bike & scooter renewals. Valid across all RTO checkpoints.",
    tags: ["Starts ₹538*", "Quick Renewal"],
  },
  {
    id: "commercial",
    title: "Commercial Vehicles",
    gstNotice: "18% GST",
    description: "Policies for auto-rickshaws, tempos (Tata Ace), delivery vans & trucks.",
    tags: ["IMT-23", "Driver Cover"],
  },
  {
    id: "life",
    title: "Term Life Insurance",
    gstNotice: "0% GST Exemption",
    description: "₹1 Crore life protection for family security. 100% tax exempt.",
    tags: ["LIC", "Tata AIA", "Section 80C"],
  },
  {
    id: "fire",
    title: "Fire & Shop Insurance",
    gstNotice: "18% GST",
    description: "Protects shops, inventory stock, and showrooms from fire and theft.",
    tags: ["Shopkeeper", "MSME Package"],
  },
  {
    id: "marine",
    title: "Marine Cargo Transit",
    gstNotice: "18% GST",
    description: "Transit protection for textiles, yarn, and machinery across India.",
    tags: ["Road & Rail", "Daily Dispatch"],
  },
  {
    id: "pa",
    title: "Personal Accident (PA)",
    gstNotice: "18% GST",
    description: "Fixed payout for accidental injury, disability, or death.",
    tags: ["₹15L Cover", "Worldwide 24x7"],
  },
  {
    id: "worker",
    title: "Factory & Worker (WC)",
    gstNotice: "18% GST",
    description: "Legal Workmen's Compensation coverage for factories & laborers.",
    tags: ["WC Act", "Factory Labor"],
  },
  {
    id: "travel",
    title: "Travel Insurance",
    gstNotice: "18% GST",
    description: "Visa-compliant travel policies covering emergency medical overseas.",
    tags: ["Schengen Approved", "USA Medical"],
  },
  {
    id: "home",
    title: "Home Insurance",
    gstNotice: "18% GST",
    description: "Covers flat structure, electronics, furniture, and jewelry.",
    tags: ["Fire & Flood", "Burglary"],
  },
  {
    id: "pet",
    title: "Pet Insurance",
    gstNotice: "18% GST",
    description: "Doctor fees, surgeries, and bite liability for dogs and cats.",
    tags: ["Surgery", "Dogs & Cats"],
  },
];
---

<Layout
  title="Amrut Insurance | IRDAI Reg. 2017342 - Insurance Advisor in Surat"
  description="Compare 28+ insurers with Amrut Patel (IRDAI Reg. 2017342) in Udhna, Surat. 0% GST on Health & Life. No spam, direct advisor help."
>
  <!-- Hero Section (Mobbin style: clean, fast, scannable) -->
  <section class="py-10 md:py-16 border-b border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <!-- Official Regulatory Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 text-xs font-mono text-zinc-700 dark:text-zinc-300 mb-4 shadow-xs">
          <span class="h-2 w-2 rounded-full bg-emerald-500" aria-hidden="true"></span>
          <span>IRDAI Reg. <strong>2017342</strong></span>
          <span class="text-zinc-300 dark:text-zinc-600">•</span>
          <span>Udhna, Surat</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-zinc-950 dark:text-zinc-50 leading-tight mb-3">
          Insurance made simple &amp; honest in Surat.
        </h1>

        <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-400 mb-6 max-w-2xl leading-relaxed">
          Compare <strong>28+ top companies</strong> like LIC, Star Health, Care, and Bajaj Allianz. Deal directly with advisor <strong>Amrut Patel</strong> — no automated bots, no spam calls.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap items-center gap-3 mb-8">
          <a
            href="https://wa.me/919824139239?text=Hello%20Amrut%20Patel%2C%20I%20would%20like%20to%20consult%20regarding%20insurance%20policies."
            target="_blank"
            rel="noopener noreferrer"
            class="px-5 py-3 rounded-lg font-semibold text-xs sm:text-sm bg-emerald-700 text-white hover:bg-emerald-800 transition-colors flex items-center justify-center gap-2 shadow-xs"
          >
            <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.299.144.35.49 1.199.534 1.286.044.087.073.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.102-.115.434-.506.549-.68.116-.173.232-.144.39-.086.159.058 1.011.477 1.184.564.173.086.289.13.332.202.043.072.043.419-.101.824z"/></svg>
            Message on WhatsApp
          </a>
          <a
            href="tel:+919824139239"
            class="px-5 py-3 rounded-lg font-semibold text-xs sm:text-sm border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 text-zinc-900 dark:text-zinc-100 hover:bg-zinc-50 dark:hover:bg-zinc-800 transition-colors flex items-center justify-center gap-2 shadow-xs"
          >
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            Call +91 98241 39239
          </a>
        </div>

        <!-- 4 Quick Trust Badges -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-5 border-t border-zinc-100 dark:border-zinc-800 text-xs">
          <div class="p-2.5 rounded-lg bg-zinc-50 dark:bg-zinc-900 border border-zinc-200/60 dark:border-zinc-800">
            <div class="font-bold text-zinc-950 dark:text-zinc-100">IRDAI Certified</div>
            <div class="text-zinc-500 text-[11px] font-mono">Reg. 2017342</div>
          </div>
          <div class="p-2.5 rounded-lg bg-zinc-50 dark:bg-zinc-900 border border-zinc-200/60 dark:border-zinc-800">
            <div class="font-bold text-zinc-950 dark:text-zinc-100">28+ Insurers</div>
            <div class="text-zinc-500 text-[11px]">Compare &amp; Save</div>
          </div>
          <div class="p-2.5 rounded-lg bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200/60 dark:border-emerald-800/60">
            <div class="font-bold text-emerald-950 dark:text-emerald-300">0% GST</div>
            <div class="text-emerald-700 dark:text-emerald-400 text-[11px]">Health &amp; Life</div>
          </div>
          <div class="p-2.5 rounded-lg bg-zinc-50 dark:bg-zinc-900 border border-zinc-200/60 dark:border-zinc-800">
            <div class="font-bold text-zinc-950 dark:text-zinc-100">Surat Office</div>
            <div class="text-zinc-500 text-[11px]">Palika Bazar, Udhna</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- GST Banner (Short & Punchy) -->
  <section class="py-4 bg-emerald-50 dark:bg-emerald-950/20 border-b border-emerald-200 dark:border-emerald-900/40">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="flex items-center gap-2.5">
          <span class="px-2 py-0.5 rounded text-[10px] font-mono font-bold bg-emerald-600 text-white uppercase">New</span>
          <p class="text-xs sm:text-sm text-emerald-950 dark:text-emerald-300 font-medium">
            <strong>0% GST on Individual Health &amp; Term Life:</strong> Save 18% tax on your policy premium.
          </p>
        </div>
        <a href="/services" class="text-xs font-semibold text-emerald-700 dark:text-emerald-400 hover:underline flex-shrink-0">
          View GST Rates →
        </a>
      </div>
    </div>
  </section>

  <!-- Partner Logos Reel -->
  <section class="py-8 border-b border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950 overflow-hidden" aria-labelledby="partners-title">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 mb-4">
      <h2 id="partners-title" class="text-[11px] font-mono font-bold uppercase tracking-wider text-zinc-400">
        Authorized Partner Insurers (28+ Companies)
      </h2>
    </div>

    <!-- Infinite Seamless Marquee Slider with Official Logos -->
    <div class="relative w-full overflow-hidden">
      <div class="flex w-max animate-marquee items-center gap-4">
        <!-- Logo Set 1 -->
        <div class="flex items-center gap-4 px-2 flex-shrink-0">
          {partnerBrands.map((brand) => (
            <div class="h-14 px-5 rounded-xl bg-white border border-zinc-200 dark:border-zinc-800 shadow-xs flex items-center justify-center" title={brand.name}>
              <img
                src={brand.file}
                alt={brand.name}
                width="120"
                height="32"
                class="h-7 max-w-[110px] w-auto object-contain"
                loading="eager"
              />
            </div>
          ))}
        </div>

        <!-- Logo Set 2 -->
        <div class="flex items-center gap-4 px-2 flex-shrink-0" aria-hidden="true">
          {partnerBrands.map((brand) => (
            <div class="h-14 px-5 rounded-xl bg-white border border-zinc-200 dark:border-zinc-800 shadow-xs flex items-center justify-center" title={brand.name}>
              <img
                src={brand.file}
                alt=""
                width="120"
                height="32"
                class="h-7 max-w-[110px] w-auto object-contain"
                loading="eager"
              />
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Popular Policies (Mobbin Clean Cards) -->
  <section id="pricing" class="py-12 md:py-16 border-b border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-zinc-900/30">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 mb-8">
        <div>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-zinc-900 dark:text-zinc-50">
            Popular Plans &amp; Starting Rates
          </h2>
          <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 mt-1">
            Standard starting rates. Share your details on WhatsApp for exact comparison.
          </p>
        </div>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {starterPlans.map((plan) => (
          <div class="p-5 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 hover:border-zinc-400 dark:hover:border-zinc-700 transition-colors flex flex-col justify-between shadow-xs">
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class={`text-[10px] font-mono font-semibold px-2 py-0.5 rounded-full ${plan.badgeColor}`}>
                  {plan.gstBadge}
                </span>
                <span class="text-[11px] text-zinc-500 font-mono">{plan.totalPrice}</span>
              </div>

              <h3 class="text-base font-bold text-zinc-900 dark:text-zinc-50 mb-0.5">{plan.category}</h3>
              <p class="text-xs text-zinc-500 dark:text-zinc-400 mb-3">{plan.tagline}</p>

              <div class="flex items-baseline gap-1 mb-4 pb-3 border-b border-zinc-100 dark:border-zinc-800">
                <span class="text-2xl font-extrabold tracking-tight text-zinc-900 dark:text-zinc-50 tabular-nums">{plan.basePrice}</span>
                <span class="text-xs text-zinc-500 font-mono">{plan.period}</span>
              </div>

              <ul class="space-y-1.5 text-xs text-zinc-600 dark:text-zinc-400 mb-5">
                {plan.features.map((feature) => (
                  <li class="flex items-center gap-1.5">
                    <svg class="h-3.5 w-3.5 text-emerald-600 dark:text-emerald-400 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                    </svg>
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
            </div>

            <a
              href={`https://wa.me/919824139239?text=${encodeURIComponent(plan.waMessage)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full py-2 px-3 rounded-lg border border-zinc-300 dark:border-zinc-700 hover:border-zinc-900 dark:hover:border-zinc-300 font-semibold text-xs text-center text-zinc-900 dark:text-zinc-100 bg-white dark:bg-zinc-800 hover:bg-zinc-50 dark:hover:bg-zinc-700 transition-colors"
            >
              Get Quote on WhatsApp →
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Complete 12 Categories Grid (Scannable Cards) -->
  <section id="services" class="py-12 md:py-16 border-b border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-8">
        <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-zinc-900 dark:text-zinc-50">
          All Insurance Services
        </h2>
        <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 mt-1">
          Select any policy to message Amrut Patel directly.
        </p>
      </div>

      <div class="grid gap-3.5 sm:grid-cols-2 lg:grid-cols-3">
        {allCategories.map((item) => (
          <article class="p-4 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/60 hover:border-zinc-400 dark:hover:border-zinc-700 transition-colors flex flex-col justify-between shadow-xs">
            <div>
              <div class="flex items-center justify-between mb-2">
                <span class={`text-[10px] font-mono font-semibold px-2 py-0.5 rounded-full ${item.gstNotice.includes('0%') ? 'bg-emerald-50 text-emerald-800 dark:bg-emerald-950/50 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800' : 'bg-zinc-100 text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400'}`}>
                  {item.gstNotice}
                </span>
              </div>
              <h3 class="text-sm font-bold text-zinc-900 dark:text-zinc-50 mb-1">{item.title}</h3>
              <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed mb-3">
                {item.description}
              </p>
            </div>

            <a
              href={`https://wa.me/919824139239?text=${encodeURIComponent(`Hi Amrut Patel, I want to consult regarding ${item.title}.`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs font-semibold text-emerald-700 dark:text-emerald-400 hover:underline pt-2 border-t border-zinc-100 dark:border-zinc-800"
            >
              Consult on WhatsApp ↗
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Work with Amrut Patel (Short 3 points) -->
  <section class="py-12 md:py-16 border-b border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-zinc-900/30">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-8">
        <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-zinc-900 dark:text-zinc-50">
          Why Choose Amrut Patel?
        </h2>
        <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 mt-1">
          Personal local advisory in Surat instead of generic online call centers.
        </p>
      </div>

      <div class="grid gap-4 sm:grid-cols-3">
        <div class="p-5 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 shadow-xs">
          <div class="text-xs font-mono font-bold text-emerald-600 dark:text-emerald-400 mb-1">01</div>
          <h3 class="font-bold text-zinc-900 dark:text-zinc-50 text-sm mb-1.5">Direct Claim Support</h3>
          <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
            During hospital admission or a vehicle accident, call Amrut Patel directly. We help coordinate with surveyors and TPA desks.
          </p>
        </div>

        <div class="p-5 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 shadow-xs">
          <div class="text-xs font-mono font-bold text-emerald-600 dark:text-emerald-400 mb-1">02</div>
          <h3 class="font-bold text-zinc-900 dark:text-zinc-50 text-sm mb-1.5">Impartial Comparison</h3>
          <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
            We compare rates across 28+ companies like Bajaj Allianz, LIC, Star Health, and Tata AIA to get you the right price.
          </p>
        </div>

        <div class="p-5 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 shadow-xs">
