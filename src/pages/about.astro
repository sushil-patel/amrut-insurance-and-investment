---
import Layout from '../layouts/Layout.astro';

const principles = [
  {
    title: "28+ Insurers Choice",
    description: "Impartial guidance across LIC, Bajaj Allianz, Star Health, Care Health, and Tata AIA. We recommend the policy that gives the best coverage at lowest cost.",
  },
  {
    title: "IRDAI Licensed Advisor",
    description: "Registered under IRDAI Reg. 2017342. All policies are directly issued through authorized portals with valid tax certificates (80D/80C).",
  },
  {
    title: "0% GST Tax Savings",
    description: "We help you save 18% tax on your family Health Insurance (Mediclaim) and Term Life Insurance under 0% GST rules.",
  },
  {
    title: "Personal Claim Support",
    description: "Direct help when admitted to a hospital or during a vehicle road accident. Call Amrut Patel directly — no bot menus.",
  },
];
---

<Layout
  title="About Amrut Patel | IRDAI Reg. 2017342 Insurance Advisor Surat"
  description="Meet Amrut Patel, licensed insurance advisor (IRDAI Reg. 2017342) in Udhna, Surat. Independent partner of 28+ leading insurers."
  canonicalURL="https://amrutinsurance.in/about"
>
  <!-- Page Header (Clean flat background, high contrast in both themes) -->
  <div class="py-10 md:py-14 border-b border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900/40">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 text-xs font-mono text-zinc-700 dark:text-zinc-300 mb-3 shadow-xs">
          <span class="h-2 w-2 rounded-full bg-emerald-500" aria-hidden="true"></span>
          IRDAI Reg. 2017342
        </div>
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-zinc-900 dark:text-zinc-50 mb-2">
          About Amrut Patel
        </h1>
        <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-400">
          Licensed insurance advisor based in Udhna, Surat. Personal guidance without call-center pressure.
        </p>
      </div>
    </div>
  </div>

  <section class="py-10 md:py-16 bg-white dark:bg-zinc-950">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-2 items-start">
        <!-- Left Column: Simple Story & Clarification -->
        <div class="space-y-5">
          <h2 class="text-xl sm:text-2xl font-extrabold text-zinc-900 dark:text-zinc-50">
            Real Advisor. Real Help. No Automated Bots.
          </h2>
          <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Most online websites sell policies through automated computer bots and call centers. When an emergency happens, it is difficult to reach someone who actually knows you.
          </p>
          <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
            At <strong>Amrut Insurance</strong>, advisor <strong>Amrut Patel</strong> assists you personally — from picking the right policy to filing hospital or vehicle accident claims.
          </p>

          <!-- Clarification Box -->
          <div class="p-4 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900/50 text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
            <strong class="text-zinc-900 dark:text-zinc-100">Firm Name Clarification:</strong> While the registered business name is <em>Amrut Insurance &amp; Investment</em>, we operate purely as an <strong>insurance advisory</strong>. We do not sell mutual funds, shares, or speculative investments.
          </div>
        </div>

        <!-- Right Column: Verification Card -->
        <div class="rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/70 p-5 sm:p-7 space-y-5 shadow-xs">
          <div class="flex items-center gap-3 pb-3 border-b border-zinc-100 dark:border-zinc-800">
            <img src="/logos/ai-brand-logo.svg" alt="AI Logo" width="36" height="36" class="h-9 w-9 rounded-lg shadow-xs" />
            <div>
              <h3 class="text-sm font-bold text-zinc-900 dark:text-zinc-50">Advisor Credentials</h3>
              <p class="text-[11px] text-zinc-500 font-mono">Government Verified Registration</p>
            </div>
          </div>
          
          <div class="space-y-3 text-xs sm:text-sm">
            <div class="flex items-center justify-between pb-2.5 border-b border-zinc-100 dark:border-zinc-800">
              <span class="text-zinc-500">Advisor</span>
              <span class="font-bold text-zinc-900 dark:text-zinc-100">Amrut Patel</span>
            </div>
            <div class="flex items-center justify-between pb-2.5 border-b border-zinc-100 dark:border-zinc-800">
              <span class="text-zinc-500">License Authority</span>
              <span class="font-medium text-zinc-900 dark:text-zinc-100">IRDAI (Govt. of India)</span>
            </div>
            <div class="flex items-center justify-between pb-2.5 border-b border-zinc-100 dark:border-zinc-800">
              <span class="text-zinc-500">IRDAI Reg. No.</span>
              <span class="font-mono font-bold text-emerald-700 dark:text-emerald-400">2017342</span>
            </div>
            <div class="flex items-center justify-between pb-2.5 border-b border-zinc-100 dark:border-zinc-800">
              <span class="text-zinc-500">Partner Companies</span>
              <span class="font-semibold text-zinc-900 dark:text-zinc-100">28+ Insurers</span>
            </div>
            <div class="flex items-center justify-between pb-2.5 border-b border-zinc-100 dark:border-zinc-800">
              <span class="text-zinc-500">Surat Office</span>
              <span class="text-zinc-900 dark:text-zinc-100">Shop 123, Palika Bazar, Udhna</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-zinc-500">Phone</span>
              <a href="tel:+919824139239" class="font-semibold text-emerald-700 dark:text-emerald-400">+91 98241 39239</a>
            </div>
          </div>

          <a
            href="https://wa.me/919824139239?text=Hello%20Amrut%20Patel%2C%20I%20would%20like%20to%20consult%20regarding%20insurance."
            target="_blank"
            rel="noopener noreferrer"
            class="w-full py-2.5 px-4 rounded-lg font-semibold text-xs text-center bg-emerald-700 text-white hover:bg-emerald-800 transition-colors flex items-center justify-center gap-2 shadow-xs"
          >
            Chat with Amrut Patel on WhatsApp
          </a>
        </div>
      </div>

      <!-- 4 Operating Standards (Clean Mobbin Cards) -->
      <div class="mt-12 pt-12 border-t border-zinc-200 dark:border-zinc-800">
        <h2 class="text-xl font-extrabold text-zinc-900 dark:text-zinc-50 mb-6 text-center">
          How We Work For You
        </h2>

        <div class="grid gap-4 sm:grid-cols-2">
          {principles.map((principle) => (
            <div class="p-5 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/60 shadow-xs">
              <h3 class="font-bold text-zinc-900 dark:text-zinc-50 text-sm mb-1.5">{principle.title}</h3>
              <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">{principle.description}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</Layout>
