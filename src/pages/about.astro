---
import Layout from '../layouts/Layout.astro';

const principles = [
  {
    title: "100% Impartial Multi-Insurer Advice",
    description: "Because we have tie-ups across 28+ leading insurers (Bajaj Allianz, LIC, TATA AIA, Care Health, Star Health, Turtlemint, RenewBuy), we do not push a single company. We recommend the policy with the lowest exclusions, best network hospitals in Surat, and fair premiums.",
  },
  {
    title: "IRDAI Registered & Verified",
    description: "Operated with active IRDAI Registration No. 2017342. All policies are directly issued through official insurer portals, ensuring valid Section 80D/80C tax certificates and verified policy documents.",
  },
  {
    title: "0% GST Exemption Guidance",
    description: "We help families take full advantage of the 56th GST Council reform, ensuring your individual Health Insurance and Term Life policies are issued under the 0% GST Nil rate, saving you 18% in unnecessary taxes.",
  },
  {
    title: "Real Claims Advocacy in Surat",
    description: "Insurance matters most when a claim occurs. Whether it is cashless hospital pre-authorization at 2 AM or coordination with a motor surveyor after a collision, our clients deal directly with Amrut Patel on phone or in-person in Surat.",
  },
];
---

<Layout
  title="About Amrut Patel | Amrut Insurance Surat (IRDAI Reg. 2017342)"
  description="Meet Amrut Patel, licensed IRDAI Reg. 2017342 insurance advisor in Udhna, Surat. Independent partner of 28+ leading insurers."
  canonicalURL="https://amrutinsurance.in/about"
>
  <!-- Page Header -->
  <div class="py-12 md:py-16 border-b border-zinc-200 dark:border-zinc-800 bg-gradient-to-b from-zinc-50/80 via-white to-white dark:from-zinc-950 dark:to-zinc-900/30">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-xs font-mono text-zinc-700 dark:text-zinc-300 mb-4 shadow-xs">
          <span class="h-2 w-2 rounded-full bg-emerald-500" aria-hidden="true"></span>
          IRDAI Registration No. 2017342
        </div>
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-zinc-950 dark:text-zinc-50 mb-4 text-balance">
          About Amrut Insurance
        </h1>
        <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 leading-relaxed text-balance">
          Independent insurance advisory led by <strong>Amrut Patel</strong>, founded on transparent advice, personal accountability, and local presence in Surat.
        </p>
      </div>
    </div>
  </div>

  <section class="py-12 md:py-20 bg-white dark:bg-zinc-950">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-2 items-start">
        <div class="space-y-6">
          <h2 class="text-2xl sm:text-3xl font-extrabold text-zinc-950 dark:text-zinc-50">
            A Licensed Advisor Working for You, Not an Algorithm
          </h2>
          <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-400 leading-relaxed">
            In an era where insurance comparison is increasingly dominated by impersonal AI algorithms, automated chat bots, and aggressive telecalling call centers, <strong>Amrut Insurance</strong> is built on a simpler, more human philosophy: <strong>a dedicated advisor who is personally accountable to you before, during, and after you buy a policy.</strong>
          </p>
          <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Founded and managed by <strong>Amrut Patel</strong>, our office is physically located at <strong>Shop No.123, Palika Bazar, near Komal Circle, Udhna, Surat</strong>. Whenever you need assistance with an urgent vehicle renewal, a commercial transit consignment policy, or a hospital admission claim form, you are dealing directly with a licensed local professional.
          </p>

          <!-- Clarification Notice as requested -->
          <div class="p-4 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900/50 text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
            <span class="font-bold text-zinc-900 dark:text-zinc-100">Clarification on Registered Firm Name:</span> Although our business entity is registered as <em>Amrut Insurance &amp; Investment</em>, we practice strictly as an <strong>insurance advisory firm</strong>. We do not distribute speculative financial investments, equity shares, mutual funds, or crypto. Our entire focus is on safeguarding your health, vehicle, life, and business assets against unforeseen risks.
          </div>
        </div>

        <div class="rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/60 p-6 sm:p-8 space-y-6 shadow-xs">
          <div class="flex items-center gap-3 pb-4 border-b border-zinc-100 dark:border-zinc-800">
            <img src="/logos/ai-brand-logo.svg" alt="AI Logo" width="40" height="40" class="h-10 w-10 rounded-lg shadow-xs" />
            <div>
              <h3 class="text-base font-bold text-zinc-950 dark:text-zinc-50">Advisor Verification &amp; Credentials</h3>
              <p class="text-xs text-zinc-500 font-mono">Government &amp; Regulatory Registration</p>
            </div>
          </div>
          
          <div class="space-y-4 text-xs sm:text-sm">
            <div class="flex items-start justify-between pb-3 border-b border-zinc-100 dark:border-zinc-800">
              <span class="text-zinc-500 font-medium">Principal Advisor</span>
              <span class="font-bold text-zinc-900 dark:text-zinc-100 text-right">Amrut Patel</span>
            </div>
            <div class="flex items-start justify-between pb-3 border-b border-zinc-100 dark:border-zinc-800">
              <span class="text-zinc-500 font-medium">Regulatory Authority</span>
              <span class="font-mono font-medium text-zinc-900 dark:text-zinc-100 text-right">Insurance Regulatory and Development Authority of India (IRDAI)</span>
            </div>
            <div class="flex items-start justify-between pb-3 border-b border-zinc-100 dark:border-zinc-800">
              <span class="text-zinc-500 font-medium">IRDAI Registration No.</span>
              <span class="font-mono font-bold text-emerald-700 dark:text-emerald-400 text-right">2017342</span>
            </div>
            <div class="flex items-start justify-between pb-3 border-b border-zinc-100 dark:border-zinc-800">
              <span class="text-zinc-500 font-medium">Partner Ecosystem</span>
              <span class="font-semibold text-zinc-900 dark:text-zinc-100 text-right">28+ Insurers (Bajaj Allianz, LIC, TATA AIA, Care Health, Star Health, Turtlemint, RenewBuy)</span>
            </div>
            <div class="flex items-start justify-between pb-3 border-b border-zinc-100 dark:border-zinc-800">
              <span class="text-zinc-500 font-medium">Office Location</span>
              <span class="text-zinc-900 dark:text-zinc-100 text-right">Shop 123, Palika Bazar, Bamroli Rd, Udhna, Surat</span>
            </div>
            <div class="flex items-start justify-between">
              <span class="text-zinc-500 font-medium">GST Advisory</span>
              <span class="font-semibold text-emerald-700 dark:text-emerald-400 text-right">0% GST on Health &amp; Term Life</span>
            </div>
          </div>

          <div class="pt-2">
            <a
              href="https://wa.me/919824139239?text=Hello%20Amrut%20Patel%2C%20I%20would%20like%20to%20consult%20regarding%20insurance."
              target="_blank"
              rel="noopener noreferrer"
              class="w-full py-3 px-4 rounded-md font-semibold text-xs text-center bg-emerald-700 text-white hover:bg-emerald-800 transition-colors flex items-center justify-center gap-2 shadow-xs focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600"
            >
              Message Amrut Patel Directly on WhatsApp
            </a>
          </div>
        </div>
      </div>

      <!-- Operating Principles -->
      <div class="mt-16 pt-16 border-t border-zinc-200 dark:border-zinc-800">
        <h2 class="text-2xl font-extrabold text-zinc-950 dark:text-zinc-50 mb-8 text-center">
          Our Advisory Standards
        </h2>

        <div class="grid gap-6 md:grid-cols-2">
          {principles.map((principle) => (
            <div class="p-6 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/60 hover-lift shadow-xs">
              <h3 class="font-bold text-zinc-950 dark:text-zinc-50 text-base mb-2">{principle.title}</h3>
              <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">{principle.description}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</Layout>
