  {
    id: "motor",
    title: "Car Insurance (TP & Comprehensive)",
    gstBadge: "18% Statutory GST",
    badgeColor: "bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700",
    partnerBrands: "Bajaj Allianz • Turtlemint • RenewBuy",
    startingRate: "TP starts at ₹2,094/yr* (<1000cc)",
    overview: "Statutory third-party liability and full bumper-to-bumper protection with cashless repair network across Surat workshops.",
    plansCovered: [
      "Third-Party (TP) Mandatory Cover",
      "Comprehensive (Own Damage + TP)",
      "Zero-Depreciation Add-on",
      "Engine & Gearbox Protection",
    ],
    documentsNeeded: "Vehicle RC Copy, Previous Year Policy.",
    waText: "Hello Amrut Patel, I need a Car Insurance renewal quote.",
  },
  {
    id: "twowheeler",
    title: "Two-Wheeler Insurance",
    gstBadge: "18% Statutory GST",
    badgeColor: "bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700",
    partnerBrands: "Bajaj Allianz • Turtlemint • RenewBuy",
    startingRate: "TP starts at ₹538/yr* (<75cc)",
    overview: "Fast policy renewal for bikes and scooters. Valid across all RTO checkpoints. No physical inspection needed for active renewals.",
    plansCovered: [
      "Third-Party Mandatory Legal Cover",
      "Comprehensive Package (Theft + Damage + Fire)",
      "Personal Accident Cover for Owner (₹15 Lakh)",
    ],
    documentsNeeded: "Vehicle RC Copy, Previous Policy.",
    waText: "Hello Amrut Patel, I need an insurance policy for my Two-Wheeler.",
  },
  {
    id: "life",
    title: "Term Life Insurance",
    gstBadge: "0% GST Exemption",
    badgeColor: "bg-emerald-50 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800",
    partnerBrands: "LIC of India • TATA AIA Life",
    startingRate: "₹1 Crore cover from ~₹490/month*",
    overview: "Financial security for your family. Pure protection with 0% GST (Save 18% tax) and tax deduction under Section 80C.",
    plansCovered: [
      "Pure Term Life Cover (up to ₹1 Crore+)",
      "Accidental Death Rider",
      "Critical Illness Benefit Rider",
    ],
    documentsNeeded: "PAN Card, Aadhaar Card, Income Proof (Salary slip or ITR).",
    waText: "Hello Amrut Patel, please guide me on ₹1 Crore Term Life Insurance plans.",
  },
  {
    id: "commercial",
    title: "Commercial Vehicle Insurance",
    gstBadge: "18% Statutory GST",
    badgeColor: "bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700",
    partnerBrands: "Bajaj Allianz • Commercial Insurers",
    startingRate: "Statutory IRDAI Tariffs",
    overview: "Coverage for auto-rickshaws, tempos (Tata Ace / Bolero Pickup), delivery vans, and heavy goods trucks in Surat.",
    plansCovered: [
      "Passenger Carrying (Autos, Taxis, School Vans)",
      "Goods Carrying (Tempos, Pickups, Trucks)",
      "IMT-23 Cover (Tyres, Lamps & Body Parts)",
      "Driver & Cleaner Legal Liability",
    ],
    documentsNeeded: "Vehicle RC, Fitness Certificate, Route Permit.",
    waText: "Hello Amrut Patel, I need insurance for a Commercial Vehicle.",
  },
  {
    id: "fire",
    title: "Fire & Shop Insurance",
    gstBadge: "18% GST",
    badgeColor: "bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700",
    partnerBrands: "Bajaj Allianz • Leading Insurers",
    startingRate: "Based on property value & stock",
    overview: "Protects shops, showrooms, factories, and godowns against fire, short-circuits, storm, earthquake, and burglary in Surat.",
    plansCovered: [
      "Building Structure & Stock Protection",
      "Shopkeeper Package (Fire + Burglary)",
      "Bharat Sookshma & Laghu Udyam (MSME)",
    ],
    documentsNeeded: "Shop address, carpet area, estimated stock & machinery value.",
    waText: "Hello Amrut Patel, I need Fire / Shop Insurance.",
  },
  {
    id: "marine",
    title: "Marine Cargo Transit Insurance",
    gstBadge: "18% GST",
    badgeColor: "bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700",
    partnerBrands: "Bajaj Allianz • Commercial Insurers",
    startingRate: "Per consignment or annual turnover",
    overview: "Protects textile, yarn, chemicals, and machinery during road, rail, air, or sea transit across Gujarat and India.",
    plansCovered: [
      "Inland Transit (Road & Rail)",
      "Annual Open Policy (Daily dispatchers)",
      "Single Transit Policy (One-time moves)",
    ],
    documentsNeeded: "Invoice value of goods, transit route (origin & destination).",
    waText: "Hello Amrut Patel, I need Marine Cargo Transit Insurance.",
  },
  {
    id: "pa",
    title: "Personal Accident (PA)",
    gstBadge: "18% GST",
    badgeColor: "bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700",
    partnerBrands: "Bajaj Allianz • Star Health • Care",
    startingRate: "Starts at ₹375/year*",
    overview: "Direct cash payout for accidental death, permanent disability, or injury. 24x7 worldwide coverage with zero medical tests.",
    plansCovered: [
      "Mandatory Owner-Driver PA (₹15 Lakh)",
      "Individual 24x7 Worldwide PA",
      "Accidental Hospital Expense Reimbursement",
    ],
    documentsNeeded: "Aadhaar Card, Nominee Details.",
    waText: "Hello Amrut Patel, I want Personal Accident (PA) Insurance.",
  },
  {
    id: "travel",
    title: "Travel Insurance",
    gstBadge: "18% GST",
    badgeColor: "bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700",
    partnerBrands: "Bajaj Allianz • Care Health",
    startingRate: "From ₹350 per trip*",
    overview: "Visa-compliant travel policies covering emergency overseas hospital bills, lost baggage, and flight cancellations.",
    plansCovered: [
      "Schengen Visa Approved (€30,000+ medical)",
      "USA & Canada Overseas Medical",
      "Student Overseas Health Plans",
    ],
    documentsNeeded: "Passport Copy, Travel Dates, Destination Country.",
    waText: "Hello Amrut Patel, I need Travel Insurance for an upcoming trip.",
  },
  {
    id: "home",
    title: "Home Insurance",
    gstBadge: "18% GST",
    badgeColor: "bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700",
    partnerBrands: "Bajaj Allianz • Leading Insurers",
    startingRate: "From ~₹1,200/year*",
    overview: "Covers flat or bungalow structure, furniture, electronics, and jewelry against fire, gas explosion, flood, and theft.",
    plansCovered: [
      "Home Structure Protection",
      "Household Contents & Electronics",
      "Burglary & Theft Protection",
    ],
    documentsNeeded: "Address, carpet area, estimated contents value.",
    waText: "Hello Amrut Patel, I would like to enquire about Home Insurance.",
  },
  {
    id: "worker",
    title: "Factory & Worker Insurance (WC)",
    gstBadge: "18% GST",
    badgeColor: "bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700",
    partnerBrands: "Bajaj Allianz • General Insurers",
    startingRate: "Based on wage roll & risk",
    overview: "Legal protection under the Workmen's Compensation Act for factory workers, laborers, and industrial staff in Surat.",
    plansCovered: [
      "Workmen's Compensation (WC) Policy",
      "Contractor All-Risk (CAR)",
      "Industrial All Risks (IAR)",
    ],
    documentsNeeded: "Worker count, wage register, type of factory work.",
    waText: "Hello Amrut Patel, I need Workmen's Compensation / Factory Insurance.",
  },
  {
    id: "pet",
    title: "Pet Insurance",
    gstBadge: "18% GST",
    badgeColor: "bg-zinc-100 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700",
    partnerBrands: "Bajaj Allianz • Pet Insurers",
    startingRate: "From ~₹2,500/year*",
    overview: "Covers veterinary doctor fees, surgeries, and third-party bite liability for companion dogs and cats.",
    plansCovered: [
      "Surgery & Inpatient Hospitalization",
      "Accidental Injury Treatment",
      "Third-Party Bite Liability",
    ],
    documentsNeeded: "Pet photo, breed, age, vaccination certificate.",
    waText: "Hello Amrut Patel, I would like to get Pet Insurance.",
  },
];
---

<Layout
  title="Insurance Services & GST Rates | Amrut Insurance Surat"
  description="Compare rates across Health (0% GST), Car, Bike, Commercial Vehicles, Term Life, and Fire Insurance. Direct advisor support from Amrut Patel in Surat."
  canonicalURL="https://amrutinsurance.in/services"
>
  <!-- Page Header (Clean flat background, high contrast in dark and light mode) -->
  <div class="py-10 md:py-14 border-b border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900/40">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 text-xs font-mono text-zinc-700 dark:text-zinc-300 mb-3 shadow-xs">
          <span class="h-2 w-2 rounded-full bg-emerald-500" aria-hidden="true"></span>
          IRDAI Reg. 2017342 • 28+ Insurers
        </div>
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-zinc-900 dark:text-zinc-50 mb-2">
          Insurance Services &amp; GST Rates
        </h1>
        <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-400">
          Clear prices, tax rules, and required documents. Select any category to get a quote directly from Amrut Patel.
        </p>
      </div>
    </div>
  </div>

  <!-- GST Quick Comparison Notice -->
  <div class="bg-white dark:bg-zinc-950 border-b border-zinc-200 dark:border-zinc-800 py-6">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-3 sm:grid-cols-2 text-xs">
        <div class="p-4 rounded-xl bg-emerald-50 text-emerald-950 border border-emerald-200 dark:bg-emerald-950/30 dark:border-emerald-800 dark:text-emerald-200">
          <div class="font-bold text-sm mb-1 flex items-center gap-1.5">
            <span class="h-2 w-2 rounded-full bg-emerald-600" aria-hidden="true"></span>
            0% GST Exemption (Save 18% Tax)
          </div>
          <p class="text-emerald-800 dark:text-emerald-300 leading-relaxed">
            <strong>Individual Health Insurance (Mediclaim)</strong> and <strong>Term Life Insurance</strong> have <strong>0% GST</strong>. You save 18% directly.
          </p>
        </div>
        <div class="p-4 rounded-xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-800 dark:text-zinc-200">
          <div class="font-bold text-sm mb-1 flex items-center gap-1.5 text-zinc-900 dark:text-zinc-100">
            <span class="h-2 w-2 rounded-full bg-zinc-400" aria-hidden="true"></span>
            18% Statutory GST
          </div>
          <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed">
            <strong>Bikes, Cars, Commercial Vehicles, Fire, Cargo, and Factory policies</strong> have standard 18% GST as per government rules.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Services Grid (Mobbin-style Cards) -->
  <section class="py-10 md:py-16 bg-zinc-50/50 dark:bg-zinc-950">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 space-y-6">
      {servicesDetail.map((service, index) => (
        <article id={service.id} class="p-5 sm:p-7 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/80 hover:border-zinc-400 dark:hover:border-zinc-700 transition-colors shadow-xs">
          <!-- Card Header -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-zinc-100 dark:border-zinc-800">
            <div>
              <div class="flex flex-wrap items-center gap-2 mb-1.5">
                <span class="text-xs font-mono font-bold text-zinc-400">#{String(index + 1).padStart(2, '0')}</span>
                <span class={`text-[11px] font-mono font-semibold px-2.5 py-0.5 rounded-full ${service.badgeColor}`}>
                  {service.gstBadge}
                </span>
                <span class="text-xs text-zinc-500 font-mono">• {service.partnerBrands}</span>
              </div>
              <h2 class="text-lg sm:text-xl font-bold text-zinc-900 dark:text-zinc-50">{service.title}</h2>
              <span class="text-xs font-mono text-emerald-700 dark:text-emerald-400 font-semibold">
                {service.startingRate}
              </span>
            </div>

            <a
              href={`https://wa.me/919824139239?text=${encodeURIComponent(service.waText)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 px-4 py-2 rounded-lg text-xs font-semibold bg-emerald-700 text-white hover:bg-emerald-800 transition-colors shadow-xs self-start sm:self-center"
            >
              <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.299.144.35.49 1.199.534 1.286.044.087.073.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.102-.115.434-.506.549-.68.116-.173.232-.144.39-.086.159.058 1.011.477 1.184.564.173.086.289.13.332.202.043.072.043.419-.101.824z"/></svg>
              Get Quote on WhatsApp
            </a>
          </div>

          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 my-3 leading-relaxed">
            {service.overview}
          </p>

          <div class="grid gap-4 sm:grid-cols-2 pt-2">
            <div>
              <h3 class="text-[11px] font-semibold uppercase tracking-wider text-zinc-500 font-mono mb-2">Available Covers</h3>
              <ul class="space-y-1.5 text-xs text-zinc-700 dark:text-zinc-300">
                {service.plansCovered.map((item) => (
                  <li class="flex items-start gap-1.5">
                    <svg class="h-3.5 w-3.5 text-emerald-600 dark:text-emerald-400 flex-shrink-0 mt-0.5" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                    </svg>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div>
              <h3 class="text-[11px] font-semibold uppercase tracking-wider text-zinc-500 font-mono mb-2">Documents Needed</h3>
              <div class="p-3 rounded-lg bg-zinc-50 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700 text-xs text-zinc-700 dark:text-zinc-300 leading-relaxed">
                {service.documentsNeeded}
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
</Layout>
