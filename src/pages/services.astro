---
import Layout from '../layouts/Layout.astro';

const servicesDetail = [
  {
    id: "health",
    title: "Health Insurance (Mediclaim)",
    gstBadge: "0% GST Exemption",
    badgeColor: "bg-emerald-50 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800",
    partnerBrands: "Care Health • Star Health • Bajaj Allianz",
    startingRate: "From ~₹450/month* (Save 18% Tax)",
    overview: "Cashless hospital admission in Surat and across India. 100% exempt from GST (0% GST) — save 18% directly on your premium.",
    plansCovered: [
      "Individual Health Plans",
      "Family Floater (Spouse & Kids under one cover)",
      "Senior Citizen Mediclaim (Pre-existing cover)",
      "Super Top-up up to ₹1 Crore",
    ],
    documentsNeeded: "PAN Card, Aadhaar Card, Previous Policy (if porting).",
