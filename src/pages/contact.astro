---
import Layout from '../layouts/Layout.astro';

const phone = "+919824139239";
const phoneDisplay = "+91 98241 39239";
const email = "amrutpatel39@gmail.com";
const address = "Shop No.123, Palika Bazar, Nr. Komal International Circle, Bamroli Road, Udhna, Surat 395002";
const googleMapsURL = "https://maps.app.goo.gl/gg2pz327yyXU8Nxv9";
---

<Layout
  title="Contact Amrut Patel | Office in Udhna, Surat (IRDAI Reg. 2017342)"
  description="Contact Amrut Patel: Call +91-9824139239 or visit Shop No.123, Palika Bazar, Udhna, Surat. Direct WhatsApp consultation with the advisor."
  canonicalURL="https://amrutinsurance.in/contact"
>
  <!-- Page Header -->
  <div class="py-12 md:py-16 border-b border-zinc-200 dark:border-zinc-800 bg-gradient-to-b from-zinc-50/80 via-white to-white dark:from-zinc-950 dark:to-zinc-900/30">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-xs font-mono text-zinc-700 dark:text-zinc-300 mb-4 shadow-xs">
          <span class="h-2 w-2 rounded-full bg-emerald-500" aria-hidden="true"></span>
          IRDAI Registration No. 2017342 • Personal Advisory
        </div>
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-zinc-950 dark:text-zinc-50 mb-4 text-balance">
          Contact Advisor Amrut Patel
        </h1>
        <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 leading-relaxed text-balance">
          Have questions about insurance coverage, renewal dates, 0% GST savings, or an ongoing claim? Reach out directly via WhatsApp, phone, or visit our office in Udhna, Surat.
        </p>
      </div>
    </div>
  </div>

  <section class="py-12 md:py-20 bg-white dark:bg-zinc-950">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-12 items-start">
        <!-- Contact Cards (5 cols) -->
        <div class="lg:col-span-5 space-y-6">
          <div class="p-6 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/60 space-y-5 shadow-xs">
            <h2 class="text-lg font-bold text-zinc-950 dark:text-zinc-50">Direct Contact Channels</h2>

            <!-- Phone Call Card -->
            <a
              href={`tel:${phone}`}
              class="flex items-start gap-4 p-4 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50/70 dark:bg-zinc-800/40 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-500"
            >
              <div class="h-10 w-10 rounded-lg bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 flex items-center justify-center text-zinc-900 dark:text-zinc-100 group-hover:scale-105 transition-transform flex-shrink-0 shadow-xs" aria-hidden="true">
                <svg class="h-5 w-5 text-emerald-700 dark:text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
              </div>
              <div>
                <span class="text-xs text-zinc-500 font-medium">Direct Advisor Phone</span>
                <div class="text-base font-bold text-zinc-950 dark:text-zinc-50 mt-0.5">{phoneDisplay}</div>
                <div class="text-xs text-emerald-700 dark:text-emerald-400 mt-0.5 font-medium">Amrut Patel answers your call directly</div>
              </div>
            </a>

            <!-- WhatsApp Card -->
            <a
              href={`https://wa.me/919824139239?text=${encodeURIComponent("Hello Amrut Patel, I would like to consult on insurance policies.")}`}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-start gap-4 p-4 rounded-xl border border-emerald-300 dark:border-emerald-800 bg-emerald-50 text-emerald-950 dark:bg-emerald-950/20 dark:text-emerald-200 hover:border-emerald-600 transition-colors group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600"
            >
              <div class="h-10 w-10 rounded-lg bg-emerald-700 text-white flex items-center justify-center group-hover:scale-105 transition-transform flex-shrink-0 shadow-xs" aria-hidden="true">
                <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.299.144.35.49 1.199.534 1.286.044.087.073.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.102-.115.434-.506.549-.68.116-.173.232-.144.39-.086.159.058 1.011.477 1.184.564.173.086.289.13.332.202.043.072.043.419-.101.824z"/></svg>
              </div>
              <div>
                <span class="text-xs text-emerald-900 dark:text-emerald-300 font-semibold">Personal WhatsApp Line</span>
                <div class="text-base font-bold text-zinc-950 dark:text-zinc-50 mt-0.5">+91 98241 39239</div>
                <div class="text-xs text-zinc-600 dark:text-zinc-400 mt-0.5">Handled personally by Amrut Patel</div>
              </div>
            </a>

            <!-- Email Card -->
            <a
              href={`mailto:${email}`}
              class="flex items-start gap-4 p-4 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50/70 dark:bg-zinc-800/40 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-500"
            >
              <div class="h-10 w-10 rounded-lg bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 flex items-center justify-center text-zinc-900 dark:text-zinc-100 group-hover:scale-105 transition-transform flex-shrink-0 shadow-xs" aria-hidden="true">
                <svg class="h-5 w-5 text-zinc-700 dark:text-zinc-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <div>
                <span class="text-xs text-zinc-500 font-medium">Email Advisory</span>
                <div class="text-sm font-bold text-zinc-950 dark:text-zinc-50 mt-0.5 break-all">{email}</div>
                <div class="text-xs text-zinc-500 mt-0.5">For fleet, commercial &amp; factory tenders</div>
              </div>
            </a>

            <!-- Office Address Card -->
            <div class="p-4 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50/70 dark:bg-zinc-800/40">
              <span class="text-xs text-zinc-500 font-medium">Office Location in Surat</span>
              <address class="not-italic text-xs text-zinc-900 dark:text-zinc-100 font-medium leading-relaxed mt-1">
                Shop No.123, Palika Bazar,<br />
                Nr. Komal International Circle,<br />
                Bamroli Road, Udhna,<br />
                Surat 395002, Gujarat, India
              </address>
              <div class="mt-3 pt-3 border-t border-zinc-200 dark:border-zinc-800">
                <a
                  href={googleMapsURL}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-700 dark:text-emerald-400 hover:underline focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent-500 rounded-sm"
                >
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                  Open in Google Maps App →
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- WhatsApp Consultation Form (7 cols) -->
        <div class="lg:col-span-7">
          <div class="p-6 sm:p-8 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/60 shadow-xs">
            <h2 class="text-xl font-bold text-zinc-950 dark:text-zinc-50 mb-1 text-balance">Consult Amrut Patel on WhatsApp</h2>
            <p class="text-xs text-zinc-500 mb-6 text-balance">
              Select your requirement below. Submitting will format your query and open a direct chat with advisor Amrut Patel. No robocalls, no spam.
            </p>

            <form id="quote-form" class="space-y-4">
              <div>
                <label for="fullName" class="block text-xs font-semibold text-zinc-900 dark:text-zinc-100 mb-1.5">
                  Your Full Name <span class="text-red-500">*</span>
                </label>
                <input
                  type="text"
                  id="fullName"
                  name="fullName"
                  required
                  autocomplete="name"
                  placeholder="e.g. Rajesh Patel…"
                  class="w-full px-3.5 py-2.5 rounded-lg border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 text-sm text-zinc-950 dark:text-zinc-50 placeholder:text-zinc-400 focus:outline-none focus:ring-2 focus:ring-emerald-600 focus:border-transparent transition-colors"
                />
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="mobileNumber" class="block text-xs font-semibold text-zinc-900 dark:text-zinc-100 mb-1.5">
                    Phone / WhatsApp Number <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="tel"
                    id="mobileNumber"
                    name="mobileNumber"
                    required
                    inputmode="tel"
                    autocomplete="tel"
                    placeholder="e.g. 98241 XXXXX…"
                    class="w-full px-3.5 py-2.5 rounded-lg border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 text-sm text-zinc-950 dark:text-zinc-50 placeholder:text-zinc-400 focus:outline-none focus:ring-2 focus:ring-emerald-600 focus:border-transparent transition-colors"
                  />
                </div>

                <div>
                  <label for="insuranceType" class="block text-xs font-semibold text-zinc-900 dark:text-zinc-100 mb-1.5">
                    Insurance Category <span class="text-red-500">*</span>
                  </label>
                  <select
                    id="insuranceType"
                    name="insuranceType"
                    required
                    class="w-full px-3.5 py-2.5 rounded-lg border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 text-sm text-zinc-950 dark:text-zinc-50 focus:outline-none focus:ring-2 focus:ring-emerald-600 focus:border-transparent transition-colors"
                  >
                    <option value="Health Insurance (Mediclaim - 0% GST)">Health Insurance (Mediclaim - 0% GST)</option>
                    <option value="Term Life Cover (0% GST)">Term Life Cover (LIC / Tata AIA - 0% GST)</option>
                    <option value="Private Car Insurance (TP & Comprehensive)">Car Insurance (TP & Comprehensive - 18% GST)</option>
                    <option value="Two-Wheeler Insurance (TP & Full)">Two-Wheeler Insurance (18% GST)</option>
                    <option value="Commercial Vehicle (Auto/Tempo/Truck)">Commercial Vehicle Insurance</option>
                    <option value="Fire & Shopkeeper Insurance">Fire & Shopkeeper Insurance</option>
                    <option value="Marine Cargo Transit">Marine Cargo Transit Insurance</option>
                    <option value="Workmen Compensation / Factory">Factory & Worker Insurance (WC)</option>
                    <option value="Personal Accident (PA)">PA (Personal Accident) Insurance</option>
                    <option value="Travel Insurance">Travel Insurance</option>
                    <option value="Home Insurance">Home Insurance</option>
                    <option value="Pet Insurance">Pet Insurance</option>
                  </select>
                </div>
              </div>

              <div>
                <label for="vehicleOrMedicalDetails" class="block text-xs font-semibold text-zinc-900 dark:text-zinc-100 mb-1.5">
                  Details / Vehicle Model / Age (Optional)
                </label>
                <textarea
                  id="vehicleOrMedicalDetails"
                  name="vehicleOrMedicalDetails"
                  rows="3"
                  placeholder="e.g. Activa 6G renewal, or looking for ₹10 Lakh family health cover for 3 members…"
                  class="w-full px-3.5 py-2.5 rounded-lg border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 text-sm text-zinc-950 dark:text-zinc-50 placeholder:text-zinc-400 focus:outline-none focus:ring-2 focus:ring-emerald-600 focus:border-transparent transition-colors"
                ></textarea>
              </div>

              <div class="pt-2">
                <button
                  type="submit"
                  class="w-full py-3.5 px-6 rounded-lg font-semibold text-sm bg-emerald-700 text-white hover:bg-emerald-800 transition-colors flex items-center justify-center gap-2 shadow-xs focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600"
                >
                  <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.299.144.35.49 1.199.534 1.286.044.087.073.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.102-.115.434-.506.549-.68.116-.173.232-.144.39-.086.159.058 1.011.477 1.184.564.173.086.289.13.332.202.043.072.043.419-.101.824z"/></svg>
                  Send Message to Amrut Patel on WhatsApp
                </button>
                <p class="text-[11px] text-zinc-500 mt-2 text-center">
                  Advisor confidentiality guarantee. Your phone number is never shared with call centers.
                </p>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    const form = document.getElementById('quote-form');
    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const name = document.getElementById('fullName').value.trim();
        const phone = document.getElementById('mobileNumber').value.trim();
        const type = document.getElementById('insuranceType').value;
        const details = document.getElementById('vehicleOrMedicalDetails').value.trim();

        const message = `Hello Amrut Patel,
My Name: ${name}
Phone: ${phone}
Consultation on: ${type}
${details ? `Details: ${details}` : ''}
Please share comparative guidance when you are free.`;

        const waUrl = `https://wa.me/919824139239?text=${encodeURIComponent(message)}`;
        window.open(waUrl, '_blank');
      });
    }
  </script>
</Layout>
