---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonicalURL?: string;
  ogImage?: string;
}

const {
  title,
  description = "Amrut Insurance - Licensed IRDAI Reg. 2017342 Insurance Advisor in Surat. Impartial guidance across Bajaj Allianz, LIC, TATA AIA, Care Health, Star Health, Turtlemint, and RenewBuy. Zero bot spam, direct advisor consultation.",
  canonicalURL = "https://amrutinsurance.in",
  ogImage = "/og-image.svg",
} = Astro.props;

const siteTitle = "Amrut Insurance";
const fullTitle = title.includes("Amrut") ? title : `${title} | Amrut Insurance`;

const phone = "+919824139239";
const phoneDisplay = "+91 98241 39239";
const email = "amrutpatel39@gmail.com";
const address = "Shop No.123, Palika Bazar, Nr. Komal International Circle, Bamroli Road, Udhna, Surat 395002";
const googleMapsURL = "https://maps.app.goo.gl/gg2pz327yyXU8Nxv9";
const whatsappURL = `https://wa.me/919824139239?text=${encodeURIComponent("Hello Amrut Patel, I would like to consult regarding insurance policies.")}`;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Theme Colors -->
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#09090b" media="(prefers-color-scheme: dark)" />

    <!-- Open Graph / Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Amrut Insurance & Investment" />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "InsuranceAgency",
      "name": "Amrut Insurance",
      "legalName": "Amrut Insurance & Investment",
      "founder": {
        "@type": "Person",
        "name": "Amrut Patel"
      },
      "description": "Licensed IRDAI Registered Insurance Advisory in Surat offering health, life, motor, commercial and factory risk covers.",
      "license": "IRDAI Registration No. 2017342",
      "url": "https://amrutinsurance.in",
      "telephone": phone,
      "email": email,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Shop No.123, Palika Bazar, Nr. Komal International Circle, Bamroli Road",
        "addressLocality": "Udhna, Surat",
        "addressRegion": "Gujarat",
        "postalCode": "395002",
        "addressCountry": "IN"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 21.1484,
        "longitude": 72.8402
      },
      "sameAs": [
        googleMapsURL
      ],
      "priceRange": "₹₹"
    })} />

    <!-- Instant Dark Mode Init Script (Zero Flash) -->
    <script is:inline>
      (function() {
        try {
          const stored = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (stored === 'dark' || (!stored && prefersDark)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (_) {}
      })();
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground flex flex-col font-sans antialiased selection:bg-accent-500 selection:text-white pb-[calc(4.5rem+env(safe-area-inset-bottom,0px))] sm:pb-0">
    <!-- Skip to main content for accessibility -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 z-50 px-4 py-2 bg-foreground text-background font-medium rounded-md shadow-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-500">
      Skip to main content
    </a>

    <!-- Top Announcement Bar: IRDAI Registration & GST 0% Notice -->
    <div class="bg-zinc-50 dark:bg-zinc-900 border-b border-zinc-200 dark:border-zinc-800 text-xs py-2 px-4 text-zinc-600 dark:text-zinc-400">
      <div class="mx-auto max-w-7xl flex flex-wrap items-center justify-between gap-2">
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300 font-mono font-semibold text-[11px] border border-emerald-200 dark:border-emerald-800">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-600 dark:bg-emerald-400" aria-hidden="true"></span>
            IRDAI Reg. 2017342
          </span>
          <span class="hidden sm:inline text-zinc-300 dark:text-zinc-700" aria-hidden="true">|</span>
          <span class="hidden md:inline font-medium text-zinc-700 dark:text-zinc-300">
            📢 0% GST Exemption on Individual Health &amp; Life Insurance (Save 18% Directly)
          </span>
        </div>
        <div class="flex items-center gap-4 text-xs">
          <a href={googleMapsURL} target="_blank" rel="noopener noreferrer" class="hover:text-zinc-950 dark:hover:text-zinc-100 transition-colors flex items-center gap-1 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent-500 rounded-sm">
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            Palika Bazar, Udhna
          </a>
          <span class="text-zinc-300 dark:text-zinc-700" aria-hidden="true">|</span>
          <a href={`tel:${phone}`} class="font-semibold text-zinc-900 dark:text-zinc-100 hover:text-emerald-700 dark:hover:text-emerald-400 transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent-500 rounded-sm">
            {phoneDisplay}
          </a>
        </div>
      </div>
    </div>

    <!-- Main Navigation Bar -->
    <header class="sticky top-0 z-40 w-full border-b border-zinc-200 dark:border-zinc-800 bg-white/95 dark:bg-zinc-950/95 backdrop-blur-md">
      <nav class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between" aria-label="Main navigation">
        <div class="flex items-center gap-8">
          <!-- Brand Logo with AI Monogram -->
          <a href="/" class="flex items-center gap-3 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-500 rounded-lg p-1" aria-label="Amrut Insurance - Home">
            <img src="/logos/ai-brand-logo.svg" alt="AI - Amrut Insurance Logo" width="36" height="36" class="h-9 w-9 rounded-lg transition-transform group-hover:scale-105 shadow-sm" />
            <div class="flex flex-col">
              <div class="flex items-center gap-1.5">
                <span class="font-extrabold text-lg tracking-tight text-zinc-950 dark:text-zinc-50 leading-none">Amrut Insurance</span>
              </div>
              <span class="text-[10px] text-zinc-500 font-mono tracking-wider mt-0.5 uppercase">Advisor: Amrut Patel • Reg. 2017342</span>
            </div>
          </a>

          <!-- Desktop Navigation Links -->
          <div class="hidden md:flex items-center gap-1">
            <a href="/" class={`px-3 py-1.5 rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-500 ${currentPath === '/' ? 'text-zinc-950 bg-zinc-100 dark:bg-zinc-800 dark:text-zinc-50 font-semibold' : 'text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-zinc-100 hover:bg-zinc-50 dark:hover:bg-zinc-900'}`}>
              Home
            </a>
            <a href="/services" class={`px-3 py-1.5 rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-500 ${currentPath.startsWith('/services') ? 'text-zinc-950 bg-zinc-100 dark:bg-zinc-800 dark:text-zinc-50 font-semibold' : 'text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-zinc-100 hover:bg-zinc-50 dark:hover:bg-zinc-900'}`}>
              Services &amp; GST Rates
            </a>
            <a href="/about" class={`px-3 py-1.5 rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-500 ${currentPath === '/about' ? 'text-zinc-950 bg-zinc-100 dark:bg-zinc-800 dark:text-zinc-50 font-semibold' : 'text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-zinc-100 hover:bg-zinc-50 dark:hover:bg-zinc-900'}`}>
              About Amrut Patel
            </a>
            <a href="/contact" class={`px-3 py-1.5 rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-500 ${currentPath === '/contact' ? 'text-zinc-950 bg-zinc-100 dark:bg-zinc-800 dark:text-zinc-50 font-semibold' : 'text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-zinc-100 hover:bg-zinc-50 dark:hover:bg-zinc-900'}`}>
              Contact &amp; Office
            </a>
          </div>
        </div>

        <!-- Right Side Actions: Theme Toggle + Personal WhatsApp -->
        <div class="flex items-center gap-3">
          <!-- Theme Toggle -->
          <button
            id="theme-toggle"
            type="button"
            class="h-9 w-9 rounded-md border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 flex items-center justify-center text-zinc-600 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-800 hover:text-zinc-950 dark:hover:text-zinc-100 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-500"
            aria-label="Toggle dark mode"
          >
            <!-- Sun Icon (shown in dark mode) -->
            <svg class="h-4 w-4 hidden dark:block text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="12" cy="12" r="5"/>
              <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
            </svg>
            <!-- Moon Icon (shown in light mode) -->
            <svg class="h-4 w-4 block dark:hidden text-zinc-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
            </svg>
          </button>

          <!-- WhatsApp Advisor Contact -->
          <a
            href={whatsappURL}
            target="_blank"
            rel="noopener noreferrer"
            class="hidden sm:inline-flex items-center gap-2 px-3.5 py-1.5 rounded-md text-xs font-semibold bg-emerald-700 text-white hover:bg-emerald-800 transition-colors shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600"
          >
            <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.299.144.35.49 1.199.534 1.286.044.087.073.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.174.086.275.072.376-.044.102-.115.434-.506.549-.68.116-.173.232-.144.39-.086.159.058 1.011.477 1.184.564.173.086.289.13.332.202.043.072.043.419-.101.824z"/>
            </svg>
            WhatsApp Advisor
          </a>

          <!-- Mobile Menu Button -->
          <button
            id="mobile-menu-btn"
            type="button"
            class="md:hidden h-9 w-9 rounded-md border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 flex items-center justify-center text-zinc-600 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-500"
            aria-label="Toggle navigation menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
          </button>
        </div>
      </nav>

      <!-- Mobile Dropdown Navigation -->
      <div id="mobile-menu" class="hidden md:hidden border-b border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950 px-4 py-4 space-y-2">
        <a href="/" class="block px-3 py-2 rounded-md text-base font-medium text-zinc-900 dark:text-zinc-100 hover:bg-zinc-100 dark:hover:bg-zinc-800">Home</a>
        <a href="/services" class="block px-3 py-2 rounded-md text-base font-medium text-zinc-900 dark:text-zinc-100 hover:bg-zinc-100 dark:hover:bg-zinc-800">Services &amp; GST Exemption</a>
        <a href="/about" class="block px-3 py-2 rounded-md text-base font-medium text-zinc-900 dark:text-zinc-100 hover:bg-zinc-100 dark:hover:bg-zinc-800">About Amrut Patel</a>
        <a href="/contact" class="block px-3 py-2 rounded-md text-base font-medium text-zinc-900 dark:text-zinc-100 hover:bg-zinc-100 dark:hover:bg-zinc-800">Office Location &amp; Contact</a>
        <div class="pt-3 border-t border-zinc-200 dark:border-zinc-800 flex flex-col gap-2">
          <a href={whatsappURL} target="_blank" rel="noopener noreferrer" class="w-full text-center py-2.5 rounded-md font-semibold text-sm bg-emerald-700 text-white hover:bg-emerald-800">
            Message Amrut Patel on WhatsApp
          </a>
          <a href={`tel:${phone}`} class="w-full text-center py-2.5 rounded-md font-medium text-sm border border-zinc-300 dark:border-zinc-700 text-zinc-900 dark:text-zinc-100">
            Call +91 98241 39239
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-950 mt-20">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
        <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
          <!-- Column 1: Advisor Info -->
          <div class="space-y-4">
            <div class="flex items-center gap-3">
              <img src="/logos/ai-brand-logo.svg" alt="AI - Amrut Insurance Logo" width="32" height="32" class="h-8 w-8 rounded-lg shadow-sm" />
              <span class="font-extrabold text-lg text-zinc-950 dark:text-zinc-50">Amrut Insurance</span>
            </div>
            <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
              Official IRDAI Reg. No. <strong>2017342</strong>. Certified insurance advisor providing independent policy advisory across Surat.
            </p>
            <div class="p-3 rounded-lg bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-[11px] text-zinc-600 dark:text-zinc-400 leading-normal">
              <strong>GST Notice:</strong> Individual Life &amp; Health policies are <strong>100% GST Exempt (0% GST)</strong> per the 56th GST Council reform. Motor and commercial policies remain subject to statutory 18% GST.
            </div>
            <div class="text-[11px] text-zinc-500 font-mono">
              Note: Firm trade name is Amrut Insurance &amp; Investment. We operate solely as an insurance advisory firm and do not provide financial investment instruments.
            </div>
          </div>

          <!-- Column 2: Quick Links -->
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-wider text-zinc-500 font-mono mb-4">
              Insurance Portfolio
            </h3>
            <ul class="space-y-2.5 text-xs text-zinc-600 dark:text-zinc-400">
              <li><a href="/services#motor" class="hover:text-zinc-950 dark:hover:text-zinc-100 transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent-500 rounded-sm">Motor (Bike, Car, Commercial - 18% GST)</a></li>
              <li><a href="/services#health" class="hover:text-zinc-950 dark:hover:text-zinc-100 transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent-500 rounded-sm">Health Insurance / Mediclaim (0% GST)</a></li>
              <li><a href="/services#life" class="hover:text-zinc-950 dark:hover:text-zinc-100 transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent-500 rounded-sm">Term &amp; Life Insurance (0% GST)</a></li>
              <li><a href="/services#pa" class="hover:text-zinc-950 dark:hover:text-zinc-100 transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent-500 rounded-sm">Personal Accident (PA) Cover</a></li>
              <li><a href="/services#commercial" class="hover:text-zinc-950 dark:hover:text-zinc-100 transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent-500 rounded-sm">Fire, Marine &amp; Factory Insurance</a></li>
              <li><a href="/services#worker" class="hover:text-zinc-950 dark:hover:text-zinc-100 transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent-500 rounded-sm">Workmen &amp; Worker Compensation</a></li>
            </ul>
          </div>

          <!-- Column 3: Partner Insurers -->
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-wider text-zinc-500 font-mono mb-4">
              Partner Insurers
            </h3>
            <ul class="space-y-2.5 text-xs text-zinc-600 dark:text-zinc-400">
              <li>Bajaj Allianz General Insurance</li>
              <li>Life Insurance Corporation of India (LIC)</li>
              <li>TATA AIA Life Insurance</li>
              <li>Care Health Insurance</li>
              <li>Star Health and Allied Insurance</li>
              <li>Turtlemint Partner Network</li>
              <li>RenewBuy Partner Network</li>
              <li class="text-xs text-zinc-500 pt-1">+ 28 Leading Insurers across India</li>
            </ul>
          </div>

          <!-- Column 4: Contact & Office -->
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-wider text-zinc-500 font-mono mb-4">
              Office &amp; Contact
            </h3>
            <address class="not-italic text-xs text-zinc-600 dark:text-zinc-400 space-y-3">
              <p class="leading-relaxed">
                Shop No.123, Palika Bazar,<br />
                Nr. Komal International Circle,<br />
                Bamroli Road, Udhna, Surat 395002
              </p>
              <p>
                <a href={`tel:${phone}`} class="font-semibold text-zinc-950 dark:text-zinc-100 hover:underline focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent-500 rounded-sm">
                  {phoneDisplay}
                </a>
              </p>
              <p>
                <a href={`mailto:${email}`} class="hover:text-zinc-950 dark:hover:text-zinc-100 transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent-500 rounded-sm">
                  {email}
                </a>
              </p>
              <p class="pt-1">
                <a href={googleMapsURL} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-700 dark:text-emerald-400 hover:underline focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-accent-500 rounded-sm">
                  <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                  Get Directions on Google Maps
                </a>
              </p>
            </address>
          </div>
        </div>

        <div class="mt-12 pt-6 border-t border-zinc-200 dark:border-zinc-800 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-zinc-500">
          <p>&copy; {new Date().getFullYear()} Amrut Insurance. IRDAI Reg. No. 2017342. All rights reserved.</p>
          <div class="flex items-center gap-4">
            <span class="inline-flex items-center gap-1.5 font-medium text-zinc-700 dark:text-zinc-300">
              <span class="h-2 w-2 rounded-full bg-emerald-600" aria-hidden="true"></span>
              Direct Advisor Consultation • Zero Automated Spam
            </span>
          </div>
        </div>
      </div>
    </footer>

    <!-- Fixed Mobile Bottom CTA Bar (Sticky for high conversion & mobile-first use) -->
    <div class="sm:hidden fixed bottom-0 left-0 right-0 z-50 bg-white/95 dark:bg-zinc-950/95 backdrop-blur-md border-t border-zinc-200 dark:border-zinc-800 p-2.5 flex items-center gap-2">
      <a
        href={`tel:${phone}`}
        class="flex-1 py-2.5 px-3 rounded-md border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 text-zinc-900 dark:text-zinc-100 text-xs font-semibold flex items-center justify-center gap-1.5 active:scale-95 transition-transform focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-500"
      >
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        Call Amrut Patel
      </a>
      <a
        href={whatsappURL}
        target="_blank"
        rel="noopener noreferrer"
